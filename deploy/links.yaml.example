# devbox 服务导航清单。
# 后端读它 (Config.LinksPath, 默认 /etc/devbox/links.yaml)，前端"服务导航"页展示。
# kind: supervisor 的 section 里，items[].supervisor 名字会被后端拿去查
# supervisor 实时状态，实时覆盖 badge，不用手工维护"RUNNING/STOPPED"。

sections:
  - title: "已上线文档站"
    description: "对外建议使用 edge-*.tkeel.io / global-*.tkeel.io 域名，Vercel fallback 仅用于临时访问。"
    items:
      - name: "edge-docs.tkeel.io"
        url: "https://edge-website-fawn.vercel.app/"
        project: "edge-website"
        badge: "Vercel READY"
        badgeKind: "ok"
      - name: "edge-design.tkeel.io"
        url: "https://edge-design-docs.vercel.app/"
        project: "edge-design-docs"
        badge: "Vercel READY"
        badgeKind: "ok"
      - name: "global-docs.tkeel.io"
        url: "https://rise-global-docs.vercel.app/"
        project: "rise-global-docs"
        badge: "Vercel READY"
        badgeKind: "ok"

  - title: "本地 Supervisor 服务"
    description: "本机 supervisor 托管的开发服务，绑定 0.0.0.0，可从 LAN 直接访问。badge 由后端实时查 supervisorctl status 填充。"
    kind: "supervisor"
    items:
      - name: "Edge Console"
        url: "http://192.168.1.200:3500/"
        supervisor: "edge-console"
      - name: "Edge OTA Console UI"
        url: "http://192.168.1.200:5180/"
        supervisor: "edge-ota-console-ui"
      - name: "Edge OTA Agent (dev)"
        url: "http://192.168.1.200:9091/"
        supervisor: "edge-ota-agent-dev"
      - name: "Rise Global Console"
        url: "http://192.168.1.200:3710/"
        supervisor: "rise-global-console"
      - name: "Rise Global APIServer"
        url: "http://192.168.1.200:3700/"
        supervisor: "rise-global-apiserver"
      - name: "Rise Cloud"
        url: "http://192.168.1.200:3200/"
        supervisor: "rise-cloud"
      - name: "Paperclip"
        url: "http://192.168.1.200:3100/"
        supervisor: "paperclip"
      - name: "Opcode Web"
        url: "http://192.168.1.200:3400/"
        supervisor: "opcode"
      - name: "Browsidian"
        url: "http://192.168.1.200:5173/"
        supervisor: "browsidian"
      - name: "LogSeq (Caddy / TLS)"
        url: "https://192.168.1.200:5200/"
        supervisor: "logseq"
        note: "自签证书；同组含 logseq-caddy / logseq-file-proxy"
      - name: "Devbox 硬件中心 (本机)"
        url: "http://10.126.126.12:9092/"
        supervisor: "devbox"
        note: "就是当前正在浏览的这个"

  - title: "预留地址"
    description: "已规划、未部署。占位用。"
    items:
      - name: "edge-console.tkeel.io"
        project: "Edge Console"
        badge: "预留"
        badgeKind: "warn"
      - name: "edge-api.tkeel.io"
        project: "Edge API"
        badge: "预留"
        badgeKind: "warn"
      - name: "edge-ota.tkeel.io"
        project: "Edge OTA / Agent"
        badge: "预留"
        badgeKind: "warn"
      - name: "global-console.tkeel.io"
        project: "Global Console"
        badge: "预留"
        badgeKind: "warn"
      - name: "global-api.tkeel.io"
        project: "Global API"
        badge: "预留"
        badgeKind: "warn"
      - name: "global-admin.tkeel.io"
        project: "Global 管理后台"
        badge: "预留"
        badgeKind: "warn"

  - title: "暂不建议动"
    description: "tkeel.io 根域当前已有 Cloudflare 站点；www.tkeel.io 可留作未来主门户；docs.tkeel.io 可留作总文档聚合入口。"
    items: []
