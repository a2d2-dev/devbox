# OTA Agent 配置文件示例
# 复制此文件为 config.yaml 并根据实际环境修改

device:
  # 设备名称（唯一标识符）
  # 留空则使用主机名
  name: "device-001"

mqtt:
  # NATS MQTT 服务器地址
  host: "198.19.249.2"  # 替换为实际的 LoadBalancer External IP

  # MQTT over TLS 端口
  port: 8883

  # CA 证书文件路径
  ca_file: "/etc/ota-agent/certs/ca.crt"

  # MQTT Client ID（留空则自动生成）
  client_id: ""

logging:
  # 日志级别: debug, info, warn, error
  level: "info"

  # 日志文件路径（留空则输出到 stdout）
  file: ""
